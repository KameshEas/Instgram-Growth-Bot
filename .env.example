# TELEGRAM BOT (REQUIRED)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# DATABASE
DATABASE_URL=postgresql+asyncpg://postgres_user:postgres_password@postgres:5432/telegram_bot
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# REDIS
REDIS_URL=redis://redis:6379

# LLM APIs (Groq - Free API) (REQUIRED)
GROQ_API_KEY=gsk-your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.7
# Optional (see docs/agents.md). Empty or unset = feature off / default.
# GROQ_MODEL_FALLBACKS=openai/gpt-oss-120b   # tried in order when the primary model is retired, blocked or rate-limited
# GROQ_MODEL_CREATIVE=                        # larger model for image-prompt generation only
# GROQ_MAX_TOKENS=3072                        # completion cap for reasoning models
# GROQ_REASONING_EFFORT=low                   # gpt-oss reasoning effort: low | medium | high
# USER_TOKENS_PER_MIN=0                       # per-user token budget per minute (0 = off); e.g. 4000 on an 8K TPM key
# GENERATION_VALIDATE=0                       # 1 = validate generated variations and retry once with feedback
# PERSIST_CHAT_STATE=0                        # 1 = keep chat history / pending clarification across restarts
# CHAT_AGENT=0                                # 1 = free-text chat uses the tool-using coach agent (2-3x tokens)
# STYLE_HINTS=0                               # 1 = use the creator's saved favorites as optional style hints

# Monitoring
LOG_LEVEL=INFO

# GENERAL
ENVIRONMENT=development
DEBUG=False
